# Auto-detect text files and normalize line endings to LF in the repo
* text=auto eol=lf

# Windows scripts — use CRLF on checkout for Windows editors, but LF in repo
*.ps1 text eol=crlf

# Shell scripts always LF
*.sh  text eol=lf

# Binary files — no line-ending conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pfx  binary
*.key  binary
*.pem  binary
*.zip  binary
*.docx binary
*.xlsx binary
*.pdf  binary
